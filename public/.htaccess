# Enable clean URLs for Next.js static export output (*.html files).
# This lets /crypto-market-maker resolve to /crypto-market-maker.html.

Options -MultiViews
DirectorySlash Off

<IfModule mod_alias.c>
  RedirectMatch 301 ^/product/?$ /market-maker
  RedirectMatch 301 ^/pricing/?$ /market-maker/pricing
  RedirectMatch 301 ^/security/?$ /market-maker/security
  RedirectMatch 301 ^/exchanges/?$ /market-maker/exchanges
  RedirectMatch 301 ^/docs/?$ /market-maker/docs
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Do not rewrite real files.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # If a matching .html file exists, serve it before same-name directories.
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # If an index.html exists in a folder (for trailing-slash exports), serve it.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ $1/index.html [L]

  # Leave real directories alone after clean URL and folder index checks.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>
